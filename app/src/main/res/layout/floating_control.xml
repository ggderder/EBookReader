<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:padding="8dp"
    android:background="@drawable/floating_bg">

    <ImageButton
        android:id="@+id/btn_rewind"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="?android:attr/actionModeUndoDrawable"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="重新朗读"
        android:tint="#fff" />

    <ImageButton
        android:id="@+id/btn_play"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="?android:attr/actionModePlayDrawable"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="开始朗读"
        android:tint="#fff"
        android:layout_marginHorizontal="8dp" />

    <ImageButton
        android:id="@+id/btn_skip"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="?android:attr/actionModeNextDrawable"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="跳过当前段落"
        android:tint="#fff" />

    <View
        android:layout_width="1dp"
        android:layout_height="32dp"
        android:background="#44ffffff"
        android:layout_marginHorizontal="8dp" />

    <ImageButton
        android:id="@+id/btn_speed"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="?android:attr/actionModeWebSearchDrawable"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="语速"
        android:tint="#fff" />

    <ImageButton
        android:id="@+id/btn_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="?android:attr/actionModeCloseDrawable"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="关闭"
        android:tint="#fff"
        android:layout_marginStart="4dp" />

</LinearLayout>
